---
import { portfolioData } from '../data/portfolio';

const { heading, description, youtubeIdOrUrl, projectTitle } = portfolioData.featuredVideo;

function extractYouTubeId(input: string): string | null {
  if (!input || !input.trim()) return null;
  const str = input.trim();

  // If already an 11-char ID
  if (/^[a-zA-Z0-9_-]{11}$/.test(str)) {
    return str;
  }

  // Handle standard youtube URLs
  try {
    const url = new URL(str);
    if (url.hostname.includes('youtube.com')) {
      const v = url.searchParams.get('v');
      if (v) return v;
      const pathParts = url.pathname.split('/').filter(Boolean);
      if (pathParts.includes('embed')) {
        return pathParts[pathParts.indexOf('embed') + 1] || null;
      }
      if (pathParts.includes('shorts')) {
        return pathParts[pathParts.indexOf('shorts') + 1] || null;
      }
    } else if (url.hostname.includes('youtu.be')) {
      const cleanPath = url.pathname.replace(/^\/+|\/+$/g, '');
      return cleanPath.split('/')[0] || null;
    }
  } catch {
    // If URL parsing fails, regex fallback below
  }

  const match = str.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|shorts\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  if (match) return match[1];

  return null;
}

const videoId = extractYouTubeId(youtubeIdOrUrl);
---

<section class="py-12 sm:py-16 border-t border-[#DCDAD1] dark:border-[#343B33]">
  <div class="space-y-4 mb-8">
    <div class="flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-[#355745] dark:bg-[#7EA488]" aria-hidden="true"></span>
      <span class="text-xs uppercase tracking-widest text-[#788873] dark:text-[#8C9688] font-semibold">
        Featured Interview
      </span>
    </div>
    <h2 class="font-serif text-2xl sm:text-3xl font-medium text-[#292D29] dark:text-[#EDEDE8]">
      {heading}
    </h2>
    <p class="text-sm sm:text-base text-[#545B52] dark:text-[#A8B0A5] leading-relaxed max-w-2xl font-sans">
      {description}
    </p>
  </div>

  <div class="max-w-4xl">
    {videoId ? (
      <div class="space-y-3">
        <div class="relative w-full aspect-video rounded-sm overflow-hidden bg-[#292D29] dark:bg-[#121412] border border-[#DCDAD1] dark:border-[#343B33] shadow-sm">
          <iframe
            class="absolute inset-0 w-full h-full"
            src={`https://www.youtube-nocookie.com/embed/${videoId}`}
            title={projectTitle || heading || "The Artisans' Archive: Sikalgars - Research Interview with Anchal Lodhi"}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          />
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-[#788873] dark:text-[#8C9688] font-sans px-1">
          <span class="font-medium text-[#292D29] dark:text-[#EDEDE8]">{projectTitle}</span>
          <a
            href={youtubeIdOrUrl.startsWith('http') ? youtubeIdOrUrl : `https://www.youtube.com/watch?v=${videoId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-1.5 text-[#355745] dark:text-[#7EA488] hover:text-[#284235] dark:hover:text-[#A8C5B0] transition-colors font-medium underline underline-offset-2"
          >
            <span>Watch on YouTube</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="relative w-full aspect-video rounded-sm overflow-hidden bg-[#EAE9E1] dark:bg-[#212520] border border-[#DCDAD1] dark:border-[#343B33] flex flex-col items-center justify-center p-6 sm:p-10 text-center group">
        <div class="w-16 h-16 rounded-full bg-[#F7F6F1] dark:bg-[#171916] border border-[#DCDAD1] dark:border-[#343B33] flex items-center justify-center text-[#355745] dark:text-[#7EA488] mb-4 shadow-xs">
          <svg class="w-7 h-7 translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </div>

        <p class="text-xs uppercase tracking-widest text-[#788873] dark:text-[#8C9688] font-semibold mb-1">
          Archival Video Recording
        </p>
        <h3 class="font-serif text-lg sm:text-xl font-medium text-[#292D29] dark:text-[#EDEDE8] mb-2 max-w-lg">
          {projectTitle}
        </h3>
        <p class="text-xs sm:text-sm text-[#545B52] dark:text-[#A8B0A5] max-w-md leading-relaxed font-sans mb-4">
          Documentation of artisan metalworkers, weapon-making lineages, craft memories, and oral traditions.
        </p>

        <div class="inline-flex items-center space-x-1.5 text-[11px] text-[#788873] dark:text-[#8C9688] bg-[#F7F6F1] dark:bg-[#171916] px-3 py-1 rounded-sm border border-[#DCDAD1] dark:border-[#343B33]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#788873] dark:bg-[#8C9688]"></span>
          <span>YouTube video link forthcoming · Configurable in portfolio.ts</span>
        </div>
      </div>
    )}
  </div>
</section>
