---
import { portfolioData } from '../data/portfolio';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[#DCDAD1] bg-[#F7F6F1] text-[#292D29] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
      <!-- Column 1: Identity & Descriptor (5 cols) -->
      <div class="md:col-span-5 space-y-3">
        <h2 class="font-serif text-2xl font-medium tracking-tight text-[#292D29]">
          {portfolioData.personal.name}
        </h2>
        <p class="text-sm text-[#788873] tracking-wide uppercase font-medium">
          {portfolioData.personal.descriptor}
        </p>
        <p class="text-sm text-[#545B52] leading-relaxed max-w-sm pt-1">
          Historical research into craft, knowledge, material culture, gender, and society across South Asia.
        </p>
      </div>

      <!-- Column 2: Navigation Links (3 cols) -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs uppercase tracking-wider text-[#788873] font-semibold">
          Navigation
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="text-[#545B52] hover:text-[#355745] transition-colors focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm">
              Home
            </a>
          </li>
          <li>
            <a href="/research-papers/" class="text-[#545B52] hover:text-[#355745] transition-colors focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm">
              Research Papers
            </a>
          </li>
          <li>
            <a href="/research-interests/" class="text-[#545B52] hover:text-[#355745] transition-colors focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm">
              Research Interests
            </a>
          </li>
          <li>
            <a href="/cv/" class="text-[#545B52] hover:text-[#355745] transition-colors focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm">
              CV
            </a>
          </li>
          <li class="pt-1">
            <a href="/#languages-scripts" class="text-xs text-[#788873] hover:text-[#355745] transition-colors focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm inline-flex items-center gap-1">
              <span>Languages & Scripts</span>
              <span aria-hidden="true">↓</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Academic Profiles & Contact (4 cols) -->
      <div class="md:col-span-4 space-y-3">
        <h3 class="text-xs uppercase tracking-wider text-[#788873] font-semibold">
          Academic Profiles & Contact
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li class="flex items-baseline space-x-2">
            <span class="text-xs text-[#788873] w-20 flex-shrink-0">Email</span>
            <a
              href={`mailto:${portfolioData.contact.email}`}
              class="text-[#355745] hover:underline underline-offset-4 font-mono text-xs sm:text-sm break-all focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm"
            >
              {portfolioData.contact.emailDisplay}
            </a>
          </li>
          <li class="flex items-baseline space-x-2">
            <span class="text-xs text-[#788873] w-20 flex-shrink-0">LinkedIn</span>
            <a
              href={portfolioData.contact.linkedInUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#545B52] hover:text-[#355745] hover:underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm"
            >
              {portfolioData.contact.linkedInHandle}
              <span class="text-xs text-[#788873] ml-1" aria-hidden="true">↗</span>
            </a>
          </li>
          <li class="flex items-baseline space-x-2">
            <span class="text-xs text-[#788873] w-20 flex-shrink-0">Academia</span>
            <a
              href={portfolioData.contact.academiaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#545B52] hover:text-[#355745] hover:underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-[#355745] rounded-sm"
            >
              {portfolioData.contact.academiaHandle}
              <span class="text-xs text-[#788873] ml-1" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Separator & Copyright -->
    <div class="mt-12 pt-6 border-t border-[#DCDAD1]/80 flex flex-col sm:flex-row items-center justify-between text-xs text-[#788873] gap-4">
      <p>
        © {currentYear} {portfolioData.personal.name}. All rights reserved.
      </p>
      <p class="text-center sm:text-right text-[11px] text-[#788873]">
        Academic Portfolio · Static Site
      </p>
    </div>
  </div>
</footer>
