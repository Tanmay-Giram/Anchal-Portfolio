---
import { portfolioData } from '../data/portfolio';

const { photos } = portfolioData.fieldwork;
---

<div class="fieldwork-gallery-root">
  <!-- 4-Photo Documentary Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
    {photos.map((photo, index) => (
      <figure class="group flex flex-col bg-[#F7F6F1] border border-[#DCDAD1] overflow-hidden transition-all duration-200 hover:border-[#BAB8AB] hover:shadow-sm">
        <button
          type="button"
          class="photo-card-trigger relative aspect-[4/3] w-full overflow-hidden bg-[#EAE9E1] text-left cursor-zoom-in focus-visible:ring-2 focus-visible:ring-[#355745] focus:outline-none"
          data-index={index}
          data-src={photo.src}
          data-alt={photo.alt}
          data-caption={photo.caption}
          data-context={photo.locationOrContext || ''}
          aria-label={`Open fieldwork photo ${index + 1}: ${photo.caption}`}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-[#292D29]/0 group-hover:bg-[#292D29]/5 transition-colors pointer-events-none" />

          <!-- Subtle zoom indicator in corner -->
          <div class="absolute bottom-2.5 right-2.5 bg-[#F7F6F1]/90 backdrop-blur-xs text-[#355745] p-1.5 rounded-sm opacity-0 group-hover:opacity-100 transition-opacity">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
            </svg>
          </div>
        </button>

        <figcaption class="p-3.5 sm:p-4 bg-[#F7F6F1] flex flex-col justify-between flex-grow border-t border-[#DCDAD1]/70">
          <p class="text-xs sm:text-sm text-[#292D29] leading-snug font-sans">
            {photo.caption}
          </p>
          {photo.locationOrContext && (
            <span class="text-[11px] uppercase tracking-wider text-[#788873] mt-2 block font-medium">
              {photo.locationOrContext}
            </span>
          )}
        </figcaption>
      </figure>
    ))}
  </div>

  <!-- Accessible Lightbox Modal (HTML5 Dialog or Controlled Modal) -->
  <div
    id="fieldwork-lightbox"
    class="fixed inset-0 z-50 hidden bg-[#292D29]/85 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6 transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Fieldwork photography lightbox viewer"
  >
    <!-- Modal Container -->
    <div
      class="relative max-w-4xl w-full bg-[#F7F6F1] rounded-sm overflow-hidden shadow-2xl flex flex-col border border-[#DCDAD1]"
      id="lightbox-container"
    >
      <!-- Top Bar: Counter & Close Button -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-[#DCDAD1] bg-[#F7F6F1]">
        <div class="flex items-center space-x-2">
          <span class="text-xs uppercase tracking-widest text-[#788873] font-semibold">
            Fieldwork Archive
          </span>
          <span class="text-xs text-[#DCDAD1]" aria-hidden="true">|</span>
          <span id="lightbox-counter" class="text-xs font-mono text-[#545B52]">
            1 of 4
          </span>
        </div>

        <button
          id="lightbox-close"
          type="button"
          class="p-1.5 text-[#545B52] hover:text-[#292D29] hover:bg-[#EAE9E1] rounded transition-colors focus-visible:ring-2 focus-visible:ring-[#355745]"
          aria-label="Close lightbox (Escape)"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Main Image Display with Navigation Arrows -->
      <div class="relative bg-[#292D29] flex items-center justify-center min-h-[300px] max-h-[70vh] overflow-hidden">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[70vh] w-auto max-w-full object-contain mx-auto transition-opacity duration-150"
        />

        <!-- Previous Button -->
        <button
          id="lightbox-prev"
          type="button"
          class="absolute left-3 top-1/2 -translate-y-1/2 bg-[#F7F6F1]/90 hover:bg-[#F7F6F1] text-[#292D29] p-2 rounded-full shadow-md transition-all focus-visible:ring-2 focus-visible:ring-[#355745]"
          aria-label="Previous photograph (Left Arrow)"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>

        <!-- Next Button -->
        <button
          id="lightbox-next"
          type="button"
          class="absolute right-3 top-1/2 -translate-y-1/2 bg-[#F7F6F1]/90 hover:bg-[#F7F6F1] text-[#292D29] p-2 rounded-full shadow-md transition-all focus-visible:ring-2 focus-visible:ring-[#355745]"
          aria-label="Next photograph (Right Arrow)"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>

      <!-- Bottom Caption Bar -->
      <div class="px-5 py-3.5 bg-[#F7F6F1] border-t border-[#DCDAD1]">
        <p id="lightbox-caption" class="text-sm text-[#292D29] font-serif"></p>
        <p id="lightbox-context" class="text-xs text-[#788873] uppercase tracking-wider font-sans mt-0.5"></p>
      </div>
    </div>
  </div>
</div>

<script>
  // Lightbox Controller
  const triggers = document.querySelectorAll<HTMLButtonElement>('.photo-card-trigger');
  const lightbox = document.getElementById('fieldwork-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxContext = document.getElementById('lightbox-context');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const container = document.getElementById('lightbox-container');

  let currentIndex = 0;
  let lastActiveElement: HTMLElement | null = null;

  const photoList = Array.from(triggers).map((btn) => ({
    src: btn.dataset.src || '',
    alt: btn.dataset.alt || '',
    caption: btn.dataset.caption || '',
    context: btn.dataset.context || ''
  }));

  function updateLightbox(index: number) {
    if (index < 0) index = photoList.length - 1;
    if (index >= photoList.length) index = 0;
    currentIndex = index;

    const current = photoList[currentIndex];
    if (lightboxImg) {
      lightboxImg.src = current.src;
      lightboxImg.alt = current.alt;
    }
    if (lightboxCaption) lightboxCaption.textContent = current.caption;
    if (lightboxContext) lightboxContext.textContent = current.context;
    if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} of ${photoList.length}`;
  }

  function openLightbox(index: number, triggerEl?: HTMLElement) {
    lastActiveElement = triggerEl || (document.activeElement as HTMLElement);
    updateLightbox(index);
    if (lightbox) {
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      if (lastActiveElement) {
        lastActiveElement.focus();
      }
    }
  }

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.dataset.index || '0', 10);
      openLightbox(idx, btn);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => updateLightbox(currentIndex - 1));
  nextBtn?.addEventListener('click', () => updateLightbox(currentIndex + 1));

  // Close on background click
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowLeft') {
      updateLightbox(currentIndex - 1);
    } else if (e.key === 'ArrowRight') {
      updateLightbox(currentIndex + 1);
    }
  });
</script>
