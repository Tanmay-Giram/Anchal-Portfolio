---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperEntry from '../components/PaperEntry.astro';
import { portfolioData } from '../data/portfolio';

const { papers, contact } = portfolioData;
---

<BaseLayout
  title="Research Papers | Anchal Lodhi"
  description="Selected research papers by Anchal Lodhi engaging with the social, cultural, material, and intellectual histories of South Asia."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Header block -->
    <header class="space-y-4 mb-10 sm:mb-14 pb-8 border-b border-[#DCDAD1] dark:border-[#343B33]">
      <p class="text-xs uppercase tracking-widest text-[#788873] dark:text-[#8C9688] font-semibold">
        Scholarship & Papers
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-[#292D29] dark:text-[#EDEDE8] tracking-tight">
        Research Papers
      </h1>
      <p class="text-base sm:text-lg text-[#545B52] dark:text-[#A8B0A5] leading-relaxed max-w-2xl font-sans">
        Selected work engaging with the social, cultural, material, and intellectual histories of South Asia.
      </p>
    </header>

    <!-- Unified List of 4 Research Papers -->
    <section aria-label="Research Papers List">
      <div class="divide-y divide-[#DCDAD1] dark:divide-[#343B33]">
        {papers.map((paper) => (
          <PaperEntry paper={paper} showAbstract={true} />
        ))}
      </div>
    </section>

    <!-- Simple, unobtrusive email inquiry paragraph immediately above footer -->
    <p class="mt-14 text-xs sm:text-sm text-[#545B52] dark:text-[#A8B0A5] leading-relaxed font-sans">
      For questions regarding methodology, sources, citations, or draft manuscripts currently forthcoming, please write directly via <a href={`mailto:${contact.email}`} class="text-[#355745] dark:text-[#7EA488] hover:underline underline-offset-4 font-medium">email</a>.
    </p>
  </div>
</BaseLayout>
