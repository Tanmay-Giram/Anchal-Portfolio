---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData, isCvAvailable } from '../data/portfolio';

const { cv, personal, contact } = portfolioData;
const available = isCvAvailable(cv.filePath, cv.isAvailable);
---

<BaseLayout
  title="Curriculum Vitae | Anchal Lodhi"
  description="Academic Curriculum Vitae of Anchal Lodhi, MA in History. Academic background, research papers, and academic inquiries."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Header Block -->
    <header class="space-y-4 mb-10 sm:mb-14 pb-8 border-b border-[#DCDAD1] dark:border-[#343B33]">
      <p class="text-xs uppercase tracking-widest text-[#788873] dark:text-[#8C9688] font-semibold">
        Academic Record
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-[#292D29] dark:text-[#EDEDE8] tracking-tight">
        {cv.title}
      </h1>
      <p class="text-base sm:text-lg text-[#545B52] dark:text-[#A8B0A5] leading-relaxed max-w-2xl font-sans">
        {cv.introText}
      </p>
    </header>

    <!-- Main CV Container -->
    <div class="space-y-10">
      {available ? (
        <div class="p-6 sm:p-8 bg-[#EAE9E1]/50 dark:bg-[#212520] border border-[#DCDAD1] dark:border-[#343B33] rounded-sm space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <h2 class="font-serif text-xl sm:text-2xl font-medium text-[#292D29] dark:text-[#EDEDE8]">
                {personal.name} — Academic CV
              </h2>
              <p class="text-xs sm:text-sm text-[#788873] dark:text-[#8C9688]">
                PDF document · Updated for PhD applications & academic review
              </p>
            </div>

            <div class="flex items-center space-x-3">
              <a
                href={cv.filePath}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center space-x-2 bg-[#355745] hover:bg-[#264032] dark:bg-[#7EA488] dark:hover:bg-[#97BAA0] text-[#F7F6F1] dark:text-[#171916] px-5 py-2.5 rounded-sm text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-[#355745] dark:focus-visible:ring-[#7EA488]"
              >
                <span>View</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>

              <a
                href={cv.filePath}
                download="Anchal_Lodhi_CV.pdf"
                class="inline-flex items-center space-x-2 bg-[#F7F6F1] hover:bg-[#EAE9E1] dark:bg-[#171916] dark:hover:bg-[#282D27] text-[#292D29] dark:text-[#EDEDE8] border border-[#DCDAD1] dark:border-[#343B33] px-5 py-2.5 rounded-sm text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-[#355745] dark:focus-visible:ring-[#7EA488]"
              >
                <span>Download CV</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ) : (
        <div class="p-8 sm:p-12 bg-[#EAE9E1]/40 dark:bg-[#212520] border border-[#DCDAD1] dark:border-[#343B33] rounded-sm text-center space-y-5">
          <div class="w-14 h-14 rounded-full bg-[#F7F6F1] dark:bg-[#171916] border border-[#DCDAD1] dark:border-[#343B33] flex items-center justify-center text-[#355745] dark:text-[#7EA488] mx-auto shadow-xs">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>

          <div class="max-w-md mx-auto space-y-2">
            <p class="text-xs uppercase tracking-widest text-[#788873] dark:text-[#8C9688] font-semibold">
              Curriculum Vitae Document
            </p>
            <h2 class="font-serif text-2xl font-medium text-[#292D29] dark:text-[#EDEDE8]">
              Academic CV Forthcoming
            </h2>
            <p class="text-sm text-[#545B52] dark:text-[#A8B0A5] leading-relaxed font-sans">
              The finalized academic CV in PDF format will be available directly on this page for viewing and download without requiring any login or form submission.
            </p>
          </div>

          <div class="inline-flex flex-col sm:flex-row items-center gap-2 p-3 bg-[#F7F6F1] dark:bg-[#171916] border border-[#DCDAD1] dark:border-[#343B33] rounded-sm text-xs text-[#788873] dark:text-[#8C9688] font-mono max-w-lg mx-auto">
            <span class="text-[#355745] dark:text-[#7EA488] font-semibold font-sans">Author Placement:</span>
            <span>Place file at <code class="text-[#292D29] dark:text-[#EDEDE8] bg-[#EAE9E1] dark:bg-[#282D27] px-1 py-0.5 rounded">public/cv/anchal-lodhi-cv.pdf</code></span>
          </div>
        </div>
      )}

      <!-- Direct Contact For Queries -->
      <div class="pt-8 border-t border-[#DCDAD1] dark:border-[#343B33] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <h3 class="font-serif text-lg font-medium text-[#292D29] dark:text-[#EDEDE8]">
            Direct Inquiries
          </h3>
          <p class="text-xs sm:text-sm text-[#545B52] dark:text-[#A8B0A5]">
            To request an advance copy or discuss academic credentials and background:
          </p>
        </div>

        <a
          href={`mailto:${contact.email}`}
          class="inline-flex items-center space-x-2 text-[#355745] dark:text-[#7EA488] hover:text-[#264032] dark:hover:text-[#97BAA0] font-mono text-xs sm:text-sm underline underline-offset-4 font-medium"
        >
          <span>{contact.emailDisplay}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
